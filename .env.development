# Development Environment Variables
# ==================================

# Application
APP_ENV=development
PORT=8080

# Database
POSTGRES_DB=member_mgmt_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/member_mgmt_dev?sslmode=disable

# JWT Secrets (dev, change in production!)
JWT_SECRET=dev-jwt-secret-key-12345678901234567890
JWT_REFRESH_SECRET=dev-refresh-secret-key-12345678901234567890

# R2 (Optional for development)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=member-mgmt-files
R2_PUBLIC_URL=

# Line API (Optional for development)
LINE_CHANNEL_ACCESS_TOKEN=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NODE_ENV=development

# Docker
BACKEND_PORT=8080
FRONTEND_PORT=3000
ADMINER_PORT=8081
POSTGRES_PORT=5432
