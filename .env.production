# Production Environment Variables
# ==================================
# IMPORTANT: Change all secrets and use strong credentials!

# Application
APP_ENV=production
PORT=8080

# Database
POSTGRES_DB=member_mgmt_prod
POSTGRES_USER=mmgmt_db_user
POSTGRES_PASSWORD=change-this-to-strong-password-12345678
POSTGRES_PORT=5432
DATABASE_URL=postgres://mmgmt_db_user:change-this-to-strong-password-12345678@postgres:5432/member_mgmt_prod?sslmode=require

# JWT Secrets (MUST be changed in production!)
JWT_SECRET=change-this-to-strong-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-this-to-strong-refresh-secret-at-least-32-characters-long

# Cloudflare R2 (Required for production file storage)
R2_ACCOUNT_ID=your-production-r2-account-id
R2_ACCESS_KEY=your-production-r2-access-key
R2_SECRET_KEY=your-production-r2-secret-key
R2_BUCKET=member-mgmt-files-prod
R2_PUBLIC_URL=https://your-r2-public-cdn-url.example.com

# Line Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-production-line-channel-token

# CORS Origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NODE_ENV=production

# Docker
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
